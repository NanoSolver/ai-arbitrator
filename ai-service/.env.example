# Any OpenAI-compatible provider works. Default below is Groq (free tier, no credit card).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=llama-3.3-70b-versatile

# --- Alternatives (swap the three lines above) ---
# Google Gemini (AI Studio key from aistudio.google.com/apikey):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=<a current Flash model name from AI Studio>
# OpenRouter (openrouter.ai/keys):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=openai/gpt-oss-120b:free

# Shared secret the Go backend sends in the X-Internal-Key header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=change-me

# Optional tuning for slow "thinking" models (e.g. Gemini): faster, cheaper, usually enough for grading.
# LLM_REASONING_EFFORT=low
# LLM_TIMEOUT=120
