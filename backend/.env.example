PORT=8080
DATABASE_URL=postgres://arbiter:arbiter@127.0.0.1:5433/arbiter?sslmode=disable

# AI service (../ai-service). INTERNAL_API_KEY must equal the one in ai-service/.env
AI_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=change-me

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Chain (leave RPC_URL/CONTRACT_ADDRESS/ORACLE_PRIVATE_KEY empty to run in DEV_MODE) ---
RPC_URL=
CHAIN_ID=11155111
CONTRACT_ADDRESS=
DEPLOY_BLOCK=
ORACLE_PRIVATE_KEY=
LOG_CHUNK=9
CONFIRMATIONS=1

# DEV_MODE=true: no contract needed; adds POST /api/dev/jobs/:id/fund and skips on-chain steps
DEV_MODE=true
